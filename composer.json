{
    "name": "velt/ui",
    "description": "Declarative UI components and renderers for the Velt framework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jules MUKADI",
            "email": "julesmukadi.dev@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "velt/kernel": "^0.1.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../veltphp-kernel/packages/kernel",
            "options": {
                "symlink": true,
                "versions": {
                    "velt/kernel": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Velt\\Ui\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.75"
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "analyse": "@php vendor/bin/phpstan analyse",
        "fix": "@php vendor/bin/php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
